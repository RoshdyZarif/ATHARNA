rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - Private (user can only access their own data)
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Bookings collection - Private (user can only access their own bookings)
    match /bookings/{bookingId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow update: if request.auth != null && request.auth.uid == resource.data.user_id;
    }
    
    // Email logs collection - Private (users can only create their own email logs)
    match /emailLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
